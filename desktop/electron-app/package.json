{
  "name": "ecopilot-desktop",
  "version": "1.0.0",
  "description": "EcoPilot - 企业生态环境合规AI管家",
  "main": "main.js",
  "scripts": {
    "dev": "electron . -- --dev",
    "start": "electron .",
    "build:frontend": "pnpm --filter ecopilot-frontend build",
    "build:icons": "node scripts/generate-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "npm run build:icons && npm run build:frontend && electron-builder",
    "dist:mac": "npm run build:icons && npm run build:frontend && electron-builder --mac"
  },
  "build": {
    "appId": "com.ecopilot.desktop",
    "productName": "EcoPilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/.next",
        "to": "frontend/.next"
      },
      {
        "from": "../frontend/next.config.mjs",
        "to": "frontend/next.config.mjs"
      },
      {
        "from": "../frontend/package.json",
        "to": "frontend/package.json"
      },
      {
        "from": "../frontend/public",
        "to": "frontend/public"
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!__pycache__",
          "!*.pyc",
          "!.venv/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "EcoPilot Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "sharp": "^0.33.0"
  }
}
