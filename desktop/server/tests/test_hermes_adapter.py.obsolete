"""Hermes 4层架构测试 — 记忆/自学习/Agent路由/GEPA进化"""
import os
import pytest
from hermes_adapter import (
    HermesMemoryLayer, HermesSelfLearningLayer,
    HermesAgentRouter, HermesGEPALayer,
    enhance_prompt_with_memory, process_with_hermes,
)


class TestGEPALayer:
    def test_evaluate_response_returns_score(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        result = gepa.evaluate_response("s1", "排污许可如何办理", "根据《排污许可管理条例》...", rating=4)
        assert "score" in result
        assert result["score"] > 0
        assert isinstance(result["issues"], list)

    def test_short_response_with_regulation_scores_high(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        result = gepa.evaluate_response("s2", "标准限值", "GB 13456-2012 表2要求 COD≤50mg/L", rating=5)
        assert result["score"] >= 5.0

    def test_long_response_without_regulation_scores_low(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        long_text = "这是很长的回复" * 200
        result = gepa.evaluate_response("s3", "问题", long_text, rating=2)
        assert result["score"] < 5.0
        assert len(result["issues"]) >= 1

    def test_get_average_quality(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        gepa.evaluate_response("s4", "q", "法规引用", rating=5)
        gepa.evaluate_response("s5", "q2", "无引用", rating=1)
        avg = gepa.get_average_quality()
        assert 1.0 <= avg <= 10.0

    def test_suggest_improvement_returns_list(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        suggestions = gepa.suggest_prompt_improvement()
        assert isinstance(suggestions, list)

    def test_iterations_counter(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        gepa = HermesGEPALayer()
        assert gepa.metrics["iterations"] == 0
        gepa.evaluate_response("s6", "q", "r", rating=3)
        assert gepa.metrics["iterations"] == 1


class TestMemoryLayer:
    def test_enterprise_profile_saved(self, tmp_path, monkeypatch):
        monkeypatch.setattr("hermes_adapter.MEMORY_DIR", tmp_path)
        mem = HermesMemoryLayer()
        mem.save_enterprise_profile("e1", {"industry": "钢铁", "permit_type": "重点管理"})
        profile = mem.get_enterprise_profile("e1")
        assert profile is not None
        assert profile["industry"] == "钢铁"


class TestAgentRouter:
    def test_regulation_query_routes_to_regulation_agent(self):
        router = HermesAgentRouter()
        result = router.route("《排污许可管理条例》第21条是什么")
        assert result["agent"] == "regulation"

    def test_monitoring_query_routes_to_monitoring_agent(self):
        router = HermesAgentRouter()
        result = router.route("检查在线监测数据是否超标")
        assert result["agent"] == "monitoring"

    def test_unknown_query_defaults_to_regulation(self):
        router = HermesAgentRouter()
        result = router.route("你好吗")
        assert result["agent"] == "regulation"


class TestHermesIntegration:
    def test_process_with_hermes_disabled(self, monkeypatch):
        old = os.environ.get("HERMES_ENABLED", "")
        monkeypatch.setenv("HERMES_ENABLED", "false")
        import hermes_adapter
        hermes_adapter.HERMES_ENABLED = False
        result = process_with_hermes("test query")
        assert result.get("hermes_enhanced") is False
        hermes_adapter.HERMES_ENABLED = (old.lower() == "true")

    def test_chinese_frontmatter_stripped(self):
        """验证 SKILL.md 格式正确加载（中文 frontmatter 兼容）"""
        assert HermesAgentRouter.AGENTS["regulation"]["name"] == "法规专家Agent"
