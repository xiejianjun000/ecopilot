# ════════════════════════════════════════
# EcoPilot 网站环境变量配置
# 复制为 .env 并填写真实值
# ════════════════════════════════════════

# ── 域名配置 ──
DOMAIN=ecopilot.example.com
SSL_CERT=/etc/ssl/certs/ecopilot.pem
SSL_KEY=/etc/ssl/private/ecopilot.key

# ── JWT 认证 ──
JWT_SECRET=your-random-secret-here

# ── AI 模型 ──
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ECOPILOT_TEXT_MODEL=deepseek-chat
ECOPILOT_VISION_MODEL=deepseek-chat

# ── Hermes ──
HERMES_ENABLED=true
HERMES_BASE_URL=http://localhost:20128/v1
HERMES_API_KEY=hermes-ecopilot-key

# ── 支付宝 ──
ALIPAY_APP_ID=2021000000000000
ALIPAY_USE_SANDBOX=true
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=https://ecopilot.example.com/api/payment/notify
ALIPAY_RETURN_URL=https://ecopilot.example.com/pricing.html?payment=success

# ── 微信支付 ──
WECHAT_APP_ID=wx0000000000000000
WECHAT_MCH_ID=1900000000
WECHAT_API_KEY_V3=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=https://ecopilot.example.com/api/payment/notify/wechat

# ── 认证配置 ──
LOGIN_WINDOW=300

# ── 运行环境（生产环境改为 production，对应 auth_service 不再返回明文密码重置码）───
# ECOPILOT_ENV=production


# ── 服务器 ──
REMOTE_HOST=root@your-server-ip
REMOTE_PATH=/var/www/ecopilot-website
